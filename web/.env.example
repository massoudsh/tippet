# اتصال دیتابیس (PostgreSQL با افزونه pgvector فعال)
DATABASE_URL="postgresql://user:password@localhost:5432/tipet?schema=public"

# پیامک OTP — در توسعه کد در پاسخ API نمایش داده می‌شود؛ در production هر دو مقدار زیر لازم است.
SMS_PROVIDER_ENABLED=""
SMS_PROVIDER_ENDPOINT=""
SMS_PROVIDER_TOKEN=""

# فضای ذخیره‌سازی تصویر — در development خالی بگذارید تا local storage استفاده شود.
STORAGE_UPLOAD_ENDPOINT=""
STORAGE_UPLOAD_TOKEN=""

# کلید سرویس AI (Vision/Text/Embedding) — provider نهایی در فاز پیاده‌سازی مشخص می‌شود
AI_PROVIDER_API_KEY=""
