# Copy to .env and adjust before running `docker compose up`.
# Used by docker-compose.yml for the postgres, migrate, and web services.

POSTGRES_DB=tipet
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_PORT=3000

# Required in production: image uploads are rejected without a remote storage adapter.
STORAGE_UPLOAD_ENDPOINT=
STORAGE_UPLOAD_TOKEN=

# Required in production: OTP codes are sent by SMS instead of returned in the API response.
SMS_PROVIDER_ENDPOINT=
SMS_PROVIDER_TOKEN=

AI_PROVIDER_API_KEY=
